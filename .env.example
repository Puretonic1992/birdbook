# Optional — without these keys the app runs in demo/mock ID mode.
# Prefer keeping keys out of the browser in production; this MVP reads VITE_* for simplicity.

VITE_OPENAI_API_KEY=
VITE_OPENAI_VISION_MODEL=gpt-4o-mini

# Or use Anthropic instead (OpenAI is preferred if both are set):
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
